  <exercise label="graphs_PI_hamiltonian-G4">
    <statement>
      <p>The graph <m>\bfG_4</m> is hamiltonian</p>
      <image width="50%">
      <description>
        <p>
          A graph with 10 vertices labeled 0 to 9. For the vertices with labels 0 through 4, the vertex with label <m>i</m> has neighbors <m>i-1</m>, <m>i+1</m>, and <m>i+5</m>. The first two adjacencies are interpreted cyclically so that, for instance, <m>4</m> has neighbors <m>3</m> and <m>0</m>. For the vertices with labels 5 through 9, the vertex with label <m>i</m> has neighbors <m>i-5</m>, <m>i+2</m>, and <m>i+3</m>. The second and third adjacencies are interpeted cyclically so that, for instance, <m>9</m> has neighbors <m>6</m> and <m>7</m>.
        </p>
      </description>
      <prefigure xmlns="https://prefigure.org" label="petersen-graph">
        <diagram dimensions="(300,300)" margins="15">
          <definition>N=5</definition>
          <definition>g(t)=(0.5*cos(2*pi*t/N), 0.5*sin(2*pi*t/N))</definition>
          <definition>f(t)=(cos(2*pi*t/N), sin(2*pi*t/N))</definition>
          <coordinates bbox="(-1,-1,1,1)">
            <network scale="0.8" node-fill="#fcf" node-stroke="black" seed="1" labels="yes" tactile-node-size="40">
              <node at="0" p="f(0)" edges="[1,4,5]"/>
              <node at="1" p="f(1)" edges="[2,6]"/>
              <node at="2" p="f(2)" edges="[3,7]"/>
              <node at="3" p="f(3)" edges="[4,8]"/>
              <node at="4" p="f(4)" edges="[9]"/>
              <node at="5" p="g(0)" edges="[7,8]"/>
              <node at="6" p="g(1)" edges="[8,9]"/>
              <node at="7" p="g(2)" edges="[9]"/>
              <node at="8" p="g(3)" edges="[]"/>
              <node at="9" p="g(4)" edges="[]"/>
            </network>
          </coordinates>
        </diagram>
      </prefigure>
    </image>
    </statement>
    <choices>
      <choice>
        <statement>
          <p>True, high confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>True, low confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Couldn't decide</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>False, low confidence</p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p>False, high confidence</p>
        </statement>
      </choice>
    </choices>
  </exercise>
  <exercise label="graphs_PI_hamiltonian-G5">
    <statement>
      <p>The graph <m>\bfG_5</m> is hamiltonian</p>
      <image>
      <shortdescription>A graph with 10 vertices and 16 edges.</shortdescription>
      <description>
        <p>
          A graph with 10 vertices labeled 0 to 9. For the vertices with labels 0 through 4, the vertex with label <m>i</m> has neighbors <m>i-1</m>, <m>i+1</m>, and <m>i+5</m>. The first two adjacencies are interpreted cyclically so that, for instance, <m>4</m> has neighbors <m>3</m> and <m>0</m>. For the vertices with labels 5 through 9, the vertex with label <m>i</m> has neighbors <m>i-5</m>, <m>i+2</m>, and <m>i+3</m>. The second and third adjacencies are interpeted cyclically so that, for instance, <m>9</m> has neighbors <m>6</m> and <m>7</m>. There is also an edge between the vertices with labels <m>7</m> and <m>8</m>.
        </p>
      </description>
      <prefigure xmlns="https://prefigure.org" label="petersen-plus-e">
        <diagram dimensions="(300,300)" margins="15">
          <definition>N=5</definition>
          <definition>g(t)=(0.5*cos(2*pi*t/N), 0.5*sin(2*pi*t/N))</definition>
          <definition>f(t)=(cos(2*pi*t/N), sin(2*pi*t/N))</definition>
          <coordinates bbox="(-1,-1,1,1)">
            <network scale="0.8" node-fill="#fcf" node-stroke="black" seed="1" labels="yes" tactile-node-size="40">
              <node at="0" p="f(0)" edges="[1,4,5]"/>
              <node at="1" p="f(1)" edges="[2,6]"/>
              <node at="2" p="f(2)" edges="[3,7]"/>
              <node at="3" p="f(3)" edges="[4,8]"/>
              <node at="4" p="f(4)" edges="[9]"/>
              <node at="5" p="g(0)" edges="[7,8]"/>
              <node at="6" p="g(1)" edges="[8,9]"/>
              <node at="7" p="g(2)" edges="[9,8]"/>
              <node at="8" p="g(3)" edges="[]"/>
              <node at="9" p="g(4)" edges="[]"/>
            </network>
          </coordinates>
        </diagram>
      </prefigure>
    </image>   
    </statement>
    <choices>
      <choice correct="yes">
        <statement>
          <p>True, high confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>True, low confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Couldn't decide</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>False, low confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>False, high confidence</p>
        </statement>
      </choice>
    </choices>
  </exercise>
  <exercise label="graphs_PI_coloring-defn">
    <statement>
      <p>
        Let <m>\bfG=(V,E)</m> be a graph. Then <m>\phi\colon V\to C</m> is a proper coloring of <m>\bfG</m> if
      </p>
    </statement>
    <choices multiple-correct="yes">
      <choice>
        <statement>
          <p><m>\phi</m> is one-to-one</p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p><m>xy\in E</m> implies <m>\phi(x)\neq \phi(y)</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p><m>\phi</m> uses as few colors from <m>C</m> as possible</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>None of the above</p>
        </statement>
      </choice>
    </choices>
  </exercise>
  <exercise label="graphs_PI_coloring-subgraph">
    <statement>
      <p>
        Let <m>\bfG=(V,E)</m> be a graph and <m>\phi\colon V\to C</m> be a proper coloring of <m>\bfG</m>. Let <m>S</m> be all vertices colored <m>1\in C</m>. How many edges does the subgraph of <m>\bfG</m> induced by <m>S</m> contain?
      </p>
    </statement>
    <choices>
      <choice correct="yes">
        <statement>
          <p>0</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>1</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p><m>|S|</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Any number is possible</p>
        </statement>
      </choice>
    </choices>
  </exercise>
  <exercise label="graphs_PI_coloring-Kn">
    <statement>
      <p>
        What is the chromatic number of the complete graph on <m>n</m> vertices <m>\bfK_n</m>?
      </p>
    </statement>
    <choices>
      <choice>
        <statement>
          <p><m>n-1</m></p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p><m>n</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p><m>n+1</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>There is no fixed formula depending on <m>n</m></p>
        </statement>
      </choice>
    </choices>
  </exercise>
