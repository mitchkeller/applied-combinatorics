        </statement>
      </choice>
      <choice>
        <statement>
          <p>False, low confidence</p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p>False, high confidence</p>
        </statement>
      </choice>
    </choices>
  </exercise>
