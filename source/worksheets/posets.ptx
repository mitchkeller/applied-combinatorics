  <worksheet xml:id="ws-posets-subset-lattice">
    <title>Width of the Subset Lattice</title>
    <!-- <page> -->
      <exercise workspace="1.5in">
        <statement>
          <p>
            Below are diagrams for <m>\mbf{2}^{4}</m> and <m>\mbf{2}^{5}</m>.
            (Without any of the points labeled with corresponding sets.) In the space provided, draw <m>\mbf{2}^{1}</m>, <m>\mbf{2}^{2}</m>, and <m>\mbf{2}^{3}</m>.
            (Label the sets, too.
            You can just write &#8220;<m>12</m>&#8221; instead of &#8220;<m>\{1,2\}</m>&#8221;.) Label a few of the points in the diagrams provided for <m>\mbf{2}^{4}</m> and <m>\mbf{2}^{5}</m> to make sure you understand how to do it.
          </p>
        </statement>
      </exercise>
