                                    <cell>6<ndash/>1</cell>
                                  </row>
                                  <row>
                                    <cell>(7,4,3,4,10,2,2,8)</cell>
                                    <cell>\(\{1,2,3,4,7,8,9,10,11,12\}\)</cell>
                                    <cell>1<ndash/>7</cell>
                                  </row>
                                  <row>
                                    <cell>(4,3,4,10,2,2,8)</cell>
                                    <cell>\(\{2,3,4,7,8,9,10,11,12\}\)</cell>
                                    <cell>7<ndash/>4</cell>
                                  </row>
                                  <row>
                                    <cell>(3,4,10,2,2,8)</cell>
                                    <cell>\(\{2,3,4,8,9,10,11,12\}\)</cell>
                                    <cell>9<ndash/>3</cell>
