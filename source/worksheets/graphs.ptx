                <diagram dimensions="(250,300)" margins="15">
                  <definition>graph={1:[2,3,5,8],2:[4,6,7],3:[4,6,7],4:[5,8],5:[6,7],6:[8],7:[8]}</definition>
                  <coordinates bbox="(-1,-1,0.5,0.75)">
                    <network graph="graph" scale="0.8" node-fill="#eee" node-stroke="black" labels="yes">
                      <node at="1" p="(-1,-1)"/>
                      <node at="2" p="(0.25,-1)"/>
                      <node at="3" p="(-0.7,-0.5)"/>
                      <node at="4" p="(0.5,-0.5)"/>
                      <node at="5" p="(-1,0.25)"/>
                      <node at="6" p="(0.25,0.25)"/>
                      <node at="7" p="(-0.7,0.75)"/>
                      <node at="8" p="(0.5,0.75)"/>
                    </network>
                  </coordinates>
                </diagram>
              </prefigure>
