  <exercise label="graphs_PI_isomorphic1">
    <statement>
      <p>
        Graphs <m>\bfG</m> and <m>\bfH</m> are isomorphic.
      </p>
<sidebyside widths="40% 40%">
        <image>
          <description>
            <p>
              A graph <m>\bfG</m> on <m>6</m> vertices. Adjacencies are given in the table below.
            </p>
            <tabular row-headers="yes">
              <row header="yes">
                <cell>Vertex</cell>
                <cell>Neighbors</cell>
              </row>
              <row>
              <cell><m>a</m></cell>
              <cell><m>e</m></cell>
              </row>
              <row>
              <cell><m>b</m></cell>
              <cell><m>c</m>, <m>d</m>, <m>f</m></cell>
              </row>
              <row>
              <cell><m>c</m></cell>
              <cell><m>b</m>, <m>d</m>, <m>e</m></cell>
              </row>
              <row>
              <cell><m>d</m></cell>
              <cell><m>b</m>, <m>c</m>, <m>e</m></cell>
              </row>
              <row>
              <cell><m>e</m></cell>
              <cell><m>a</m>, <m>c</m>, <m>d</m>, <m>f</m></cell>
              </row>
              <row>
              <cell><m>f</m></cell>
              <cell><m>b</m>, <m>e</m></cell>
              </row>
            </tabular>
          </description>
          <prefigure xmlns="https://prefigure.org" label="img-isomorphic1-G-PI">
            <diagram dimensions="(300,300)" margins="15">
              <definition>graph={1:[5],2:[3,4,6],3:[4,5],4:[5],5:[6]}</definition>
              <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f'}</definition>
              <coordinates bbox="(0,0,5,5)">
                <network directed="no" graph="graph"
                        label-dictionary="labels"
                        scale="0.8" node-fill="#ddd" seed="128"
                        labels="yes">
                  <node at="1" p="(1.75,2.5)" />
                  <node at="2" p="(2.75,2.2)" />
                  <node at="3" p="(5,0.3)" />
                  <node at="4" p="(2.5,5)" />
                  <node at="5" p="(0,0.3)" />
                  <node at="6" p="(1.9,1.2)" />
                </network>
                <label anchor="(2.5,0)"><m>\mathbf{G}</m></label>
              </coordinates>
            </diagram>        
          </prefigure>
        </image>
        <image>
          <description>
            <p>
              A graph <m>\bfH</m> on <m>6</m> vertices. Adjacencies are given in the table below.
            </p>
            <tabular row-headers="yes">
              <row header="yes">
                <cell>Vertex</cell>
                <cell>Neighbors</cell>
              </row>
              <row>
              <cell><m>1</m></cell>
              <cell><m>2</m></cell>
              </row>
              <row>
              <cell><m>2</m></cell>
              <cell><m>1</m>, <m>5</m>, <m>6</m>, <m>4</m></cell>
              </row>
              
              <row>
              <cell><m>3</m></cell>
              <cell><m>5</m>, <m>6</m>, <m>4</m></cell>
              </row>
              <row>
              <cell><m>4</m></cell>
              <cell><m>3</m>, <m>2</m></cell>
              </row>
              <row>
              <cell><m>5</m></cell>
              <cell><m>3</m>, <m>6</m>, <m>2</m></cell>
              </row>
              <row>
              <cell><m>6</m></cell>
              <cell><m>3</m>, <m>5</m>, <m>2</m></cell>
              </row>
              
            </tabular>
          </description>
          <prefigure xmlns="https://prefigure.org" label="img-isomorphic1-H-PI">
            <diagram dimensions="(300,300)" margins="15">
              <definition>graph={1:[5],2:[3,4,6],3:[4,5],4:[5],5:[6]}</definition>
              <definition>labels={1:'1',2:'3',3:'5',4:'6',5:'2',6:'4'}</definition>
              <coordinates bbox="(0,0,5,5)">
                <network directed="no" graph="graph"
                        label-dictionary="labels"
                        scale="0.8" node-fill="#ddd" seed="128"
                        labels="yes">
                  <node at="1" p="(0,0)" />
                  <node at="2" p="(4.5,4.5)" />
                  <node at="3" p="(5,1.5)" />
                  <node at="4" p="(2.5,3)" />
                  <node at="5" p="(1.7,1.5)" />
                  <node at="6" p="(0.9,4.5)" />
                </network>
                <label anchor="(2.5,0)"><m>\mathbf{H}</m></label>
              </coordinates>
            </diagram>   
          </prefigure>
        </image>    
      </sidebyside>
    </statement>
    <choices>
      <choice correct="yes">
        <statement>
          <p>True, high confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>True, low confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>False, low confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>False, high confidence</p>
        </statement>
      </choice>
    </choices>
  </exercise>
  <exercise label="graphs_PI_isomorphic2">
    <statement>
      <p>
        Graphs <m>\bfG</m> and <m>\bfH</m> are isomorphic.
      </p>
      <sidebyside widths="40% 40%">
        <image>
          <description>
            <p>
              A graph <m>\bfG</m> on <m>6</m> vertices. Adjacencies are given in the table below.
            </p>
            <tabular row-headers="yes">
              <row header="yes">
                <cell>Vertex</cell>
                <cell>Neighbors</cell>
              </row>
              <row>
              <cell><m>a</m></cell>
              <cell><m>c</m></cell>
              </row>
              <row>
              <cell><m>b</m></cell>
              <cell><m>c</m>, <m>d</m>, <m>f</m></cell>
              </row>
              <row>
              <cell><m>c</m></cell>
              <cell><m>a</m>, <m>b</m>, <m>d</m>, <m>e</m></cell>
              </row>
              <row>
              <cell><m>d</m></cell>
              <cell><m>b</m>, <m>c</m>, <m>e</m></cell>
              </row>
              <row>
              <cell><m>e</m></cell>
              <cell><m>c</m>, <m>d</m>, <m>f</m></cell>
              </row>
              <row>
              <cell><m>f</m></cell>
              <cell><m>b</m>, <m>e</m></cell>
              </row>
            </tabular>
          </description>
          <prefigure xmlns="https://prefigure.org" label="img-isomorphic2-G-PI">
            <diagram dimensions="(300,300)" margins="15">
              <definition>graph={1:[3],2:[3,4,6],3:[4,5],4:[5],5:[6]}</definition>
              <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f'}</definition>
              <coordinates bbox="(0,0,5,5)">
                <network directed="no" graph="graph"
                        label-dictionary="labels"
                        scale="0.8" node-fill="#ddd" seed="128"
                        labels="yes">
                  <node at="1" p="(3.25,0.75)" />
                  <node at="2" p="(2.75,2.2)" />
                  <node at="3" p="(5,0.3)" />
                  <node at="4" p="(2.5,5)" />
                  <node at="5" p="(0,0.3)" />
                  <node at="6" p="(1.9,1.2)" />
                </network>
                <label anchor="(2.5,0)"><m>\mathbf{G}</m></label>
              </coordinates>
            </diagram>        
          </prefigure>
        </image>
        <image>
          <description>
