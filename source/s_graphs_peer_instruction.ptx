<exercises xml:id="s_graphs_PI" component="runestone-PI">
  <title>Peer Instruction Questions</title>
  <exercise label="graphs_PI_subgraph1">
    <statement>
      <p>Choose the best response.
      </p>
            <sidebyside widths="30% 30%">
        <image>
          <description>
            <p>
              A graph with <m>10</m> vertices. Adjacencies are given in the table below.
            </p>
            <tabular row-headers="yes">
              <row header="yes">
                <cell>Vertex</cell>
                <cell>Neighbors</cell>
              </row>
              <row>
                <cell><m>1</m></cell>
                <cell><m>5</m>, <m>7</m></cell>
                </row>
                <row>
                <cell><m>2</m></cell>
                <cell><m>3</m>, <m>5</m>, <m>6</m>, <m>7</m></cell>
                </row>
                <row>
                <cell><m>3</m></cell>
                <cell><m>2</m>, <m>5</m>, <m>8</m>, <m>10</m></cell>
                </row>
                <row>
                <cell><m>4</m></cell>
                <cell><m>7</m>, <m>10</m></cell>
                </row>
                <row>
                <cell><m>5</m></cell>
                <cell><m>1</m>, <m>2</m>, <m>3</m>, <m>6</m></cell>
                </row>
                <row>
                <cell><m>6</m></cell>
                <cell><m>2</m>, <m>5</m></cell>
                </row>
                <row>
                <cell><m>7</m></cell>
                <cell><m>1</m>, <m>2</m>, <m>4</m>, <m>10</m></cell>
                </row>
                <row>
                <cell><m>8</m></cell>
                <cell><m>3</m>, <m>9</m></cell>
                </row>
                <row>
                <cell><m>9</m></cell>
                <cell><m>8</m>, <m>10</m></cell>
                </row>
                <row>
                <cell><m>10</m></cell>
                <cell><m>3</m>, <m>4</m>, <m>7</m>, <m>9</m></cell>
                </row>
            </tabular>
          </description>
          <prefigure xmlns="https://prefigure.org" label="img-spanning-subgraph-1-PI">
            <diagram dimensions="(200,300)" margins="5">
              <definition>graph={1:[5,7],
                2:[3,5,6,7],
                3:[5,8,10],
                4:[7,10],
                5:[6],
                7:[10],
                8:[9],
                9:[10]}</definition>
              <coordinates bbox="(-1,-1,1,1)">
                <network directed="no" graph="graph"
                        scale="0.8" node-fill="#ddd" seed="781"
                        labels="yes">
                </network>
              </coordinates>
            </diagram>
          </prefigure>
        </image>
        <image>
          <description>
            <p>
              A graph with <m>10</m> vertices. Adjacencies are given in the table below.
            </p>
            <tabular row-headers="yes">
              <row header="yes">
                <cell>Vertex</cell>
                <cell>Neighbors</cell>
              </row>
              <row>
                <cell><m>1</m></cell>
                <cell><m>5</m></cell>
                </row>
                <row>
                <cell><m>2</m></cell>
                <cell><m>3</m>, <m>5</m>, <m>6</m></cell>
                </row>
                <row>
                <cell><m>3</m></cell>
                <cell><m>2</m>, <m>8</m>, <m>10</m></cell>
                </row>
                <row>
                <cell><m>4</m></cell>
                <cell><m>7</m></cell>
                </row>
                <row>
                <cell><m>5</m></cell>
                <cell><m>1</m>, <m>2</m>, <m>6</m></cell>
                </row>
                <row>
                <cell><m>6</m></cell>
                <cell><m>2</m>, <m>5</m></cell>
                </row>
                <row>
                <cell><m>7</m></cell>
                <cell><m>4</m>, <m>10</m></cell>
                </row>
                <row>
                <cell><m>8</m></cell>
                <cell><m>3</m></cell>
                </row>
                <row>
                <cell><m>9</m></cell>
                <cell></cell>
                </row>
                <row>
                <cell><m>10</m></cell>
                <cell><m>3</m>, <m>7</m></cell>
                </row>
            </tabular>
          </description>
          <prefigure xmlns="https://prefigure.org" label="img-spanning-subgraph-2-PI">
            <diagram dimensions="(200,300)" margins="5">
              <definition>graph={1:[5,7],
                2:[3,5,6,7],
                3:[5,8,10],
                4:[7,10],
                5:[6],
                7:[10],
                8:[9],
                9:[10]}</definition>
              <coordinates bbox="(-1,-1,1,1)">
                <network directed="no" graph="graph"
                        scale="0.8" node-fill="#ddd" seed="781"
                        labels="yes">
                  <edge vertices="(1,7)" stroke="none"/>
                  <edge vertices="(4,10)" stroke="none"/>
                  <edge vertices="(2,7)" stroke="none"/>
                  <edge vertices="(3,5)" stroke="none"/>
                  <edge vertices="(8,9)" stroke="none"/>
                  <edge vertices="(9,10)" stroke="none"/>
                </network>
              </coordinates>
            </diagram>
          </prefigure>
        </image>

      </sidebyside>

    </statement>
    <choices>
      <choice>
        <statement>
          <p><m>\bfH</m> is a subgraph of <m>\bfG</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p><m>\bfH</m> is an induced subgraph of <m>\bfG</m></p>
        </statement>
      </choice>
      <choice correct="yes">
        <statement>
          <p><m>\bfH</m> is a spanning subgraph of <m>\bfG</m></p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>None of the above</p>
        </statement>
      </choice>
    </choices>
  </exercise>
