<chapter xmlns:xi="http://www.w3.org/2001/XInclude" xml:id="ws-inclusion-exclusion" component="pie">
  
    <!-- </page> -->
     
  <title>Principle of Inclusion-Exclusion</title>

  <worksheet xml:id="ws-inclusion-exclusion-surjections" component="pie-surjections">
    <title>Counting Surjections</title>
    <page>
    <exercise workspace="1cm">
      <introduction>
        <p>
          Let's first focus on the case of counting surjections from <m>[8]</m> to <m>[5]</m>.
        </p>
      </introduction>

      
      <task>
        <p>
          How many properties are in <m>\mc{P}</m>? What are they?
        </p>
      </task>

      <task>
        <p>
          How many functions satisfy <m>P_{1}</m>? What about <m>P_{3}</m>?
        </p>
      </task>

      <task>
        <p>
          How many functions satisfy <m>P_{1}</m> <em>and</em> <m>P_{3}</m>?
        </p>
      </task>

      <task>
        <p>
          How many functions satisfy <m>P_{2}</m> <em>and</em> <m>P_{5}</m>?
        </p>
      </task>

      <task>
        <p>
          Let <m>S\subseteq [5]</m> with <m>|S|=3</m>.
          How many functions satisfy all properties in <m>S</m>?
        </p>
      </task>

      <task workspace="2cm">
        <p>
          Use inclusion-exclusion to find the number of surjections from <m>[8]</m> to <m>[5]</m>.
          (You might want to put your formula into an online calculator.)
        </p>
      </task>
    </exercise>
  </page>
  <page>
    <exercise workspace="1cm">
      <introduction>
        <p>
          Now let's count surjections from <m>[n]</m> to <m>[m]</m> (<m>n\gt m</m>).
        </p>
      </introduction>

      
      <task>
        <p>
          How many properties are in <m>\mc{P}</m>? 
        </p>
      </task>

      <task>
        <p>
          How many functions satisfy <m>P_{1}</m>? What about <m>P_{3}</m>?
        </p>
      </task>

      <task>
        <p>
          How many functions satisfy <m>P_{1}</m> <em>and</em> <m>P_{3}</m>?
        </p>
      </task>

      <task>
        <p>
          Let <m>S\subseteq [m]</m> with <m>|S|=4</m>.
          How many functions satisfy all properties in <m>S</m>?
        </p>
      </task>

      <task>
        <p>
          Let <m>S\subseteq [m]</m> with <m>|S|=j</m>.
          How many functions satisfy all properties in <m>S</m>?
        </p>
      </task>
      <task>
        <statement>
          <p>
            How many subsets of <m>[m]</m> have size <m>j</m>?
          </p>
        </statement>
      </task>
      <task workspace="2cm">
        <p>
          Use inclusion-exclusion to find the number of surjections from <m>[n]</m> to <m>[m]</m>.
          
        </p>
      </task>
    </exercise>
  </page>
  </worksheet>
</chapter>
