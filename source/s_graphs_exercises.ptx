                                  <row>
                                    <cell>(2,8)</cell>
                                    <cell>\(\{2,8,11,12\}\)</cell>
                                    <cell>11<ndash/>2</cell>
                                  </row>
                                  <row>
                                    <cell>(8)</cell>
                                    <cell>\(\{2,8,12\}\)</cell>
                                    <cell>2<ndash/>8</cell>
