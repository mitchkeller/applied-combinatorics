              </row>
              
              <row>
              <cell><m>3</m></cell>
              <cell><m>5</m>, <m>6</m>, <m>4</m></cell>
              </row>
              <row>
              <cell><m>4</m></cell>
              <cell><m>3</m>, <m>2</m></cell>
              </row>
              <row>
              <cell><m>5</m></cell>
              <cell><m>3</m>, <m>6</m>, <m>2</m></cell>
              </row>
              <row>
              <cell><m>6</m></cell>
              <cell><m>3</m>, <m>5</m>, <m>2</m></cell>
              </row>
              
            </tabular>
          </description>
          <prefigure xmlns="https://prefigure.org" label="img-isomorphic2-H-PI">
            <diagram dimensions="(300,300)" margins="15">
              <definition>graph={1:[5],2:[3,4,6],3:[4,5],4:[5],5:[6]}</definition>
              <definition>labels={1:'1',2:'3',3:'5',4:'6',5:'2',6:'4'}</definition>
              <coordinates bbox="(0,0,5,5)">
                <network directed="no" graph="graph"
                        label-dictionary="labels"
                        scale="0.8" node-fill="#ddd" seed="128"
                        labels="yes">
                  <node at="1" p="(0,0)" />
                  <node at="2" p="(4.5,4.5)" />
                  <node at="3" p="(5,1.5)" />
                  <node at="4" p="(2.5,3)" />
                  <node at="5" p="(1.7,1.5)" />
                  <node at="6" p="(0.9,4.5)" />
                </network>
                <label anchor="(2.5,0)"><m>\mathbf{H}</m></label>
              </coordinates>
            </diagram>   
