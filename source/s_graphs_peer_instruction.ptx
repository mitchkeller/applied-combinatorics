  <exercise label="graphs_PI_hamiltonian-G1">
    <statement>
      <p>The graph <m>\bfG_1</m> is hamiltonian</p>
      <image width="40%">
      <description>
        <p>
          A graph with 10 vertices. The neighbors of each vertex are given in the table below.
        </p>
        <tabular>
          <row>
            <cell>Vertex</cell>
            <cell>Neighbors</cell>
          </row>
          <row>
            <cell><m>1</m></cell>
            <cell><m>4</m>, <m>5</m></cell>
          </row>
          <row>
            <cell><m>2</m></cell>
            <cell><m>3</m>, <m>6</m>, <m>9</m></cell>
          </row>
          <row>
            <cell><m>3</m></cell>
            <cell><m>2</m>, <m>7</m>, <m>10</m></cell>
          </row>
          <row>
            <cell><m>4</m></cell>
            <cell><m>1</m>, <m>7</m>, <m>8</m>, <m>10</m></cell>
          </row>
          <row>
            <cell><m>5</m></cell>
            <cell><m>1</m>, <m>6</m>, <m>7</m></cell>
          </row>
          <row>
            <cell><m>6</m></cell>
            <cell><m>2</m>, <m>5</m>, <m>8</m></cell>
          </row>
          <row>
            <cell><m>7</m></cell>
            <cell><m>3</m>, <m>4</m>, <m>5</m></cell>
          </row>
          <row>
            <cell><m>8</m></cell>
            <cell><m>4</m>, <m>6</m>, <m>9</m></cell>
          </row>
          <row>
            <cell><m>9</m></cell>
            <cell><m>2</m>, <m>8</m>, <m>10</m></cell>
          </row>
          <row>
            <cell><m>10</m></cell>
            <cell><m>3</m>, <m>4</m>, <m>9</m></cell>
          </row>
        </tabular>
      </description>
      <prefigure xmlns="https://prefigure.org" label="img-hamgraph1">
        <diagram dimensions="(200,300)" margins="5">
          <definition>graph={1:[4,5],2:[3,6,9],3:[7,10],4:[7,8,10],5:[6,7],6:[8],8:[9],9:[10]}</definition>
          <coordinates bbox="(-1,-1,1,1)">
            <network graph="graph" scale="0.8" node-fill="#fcf" node-stroke="black" seed="1" labels="yes">
            </network>
          </coordinates>
        </diagram>
      </prefigure>
    </image>
    </statement>
    <choices>
      <choice correct="yes">
        <statement>
          <p>True, high confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>True, low confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>Couldn't decide</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>False, low confidence</p>
        </statement>
      </choice>
      <choice>
        <statement>
          <p>False, high confidence</p>
        </statement>
      </choice>
    </choices>
  </exercise>
